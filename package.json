{
  "name": "beatbloom",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "A private, local-first browser music studio",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/finalize-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:production": "playwright test --config playwright.production.config.js"
  },
  "dependencies": {
    "idb": "8.0.4",
    "lucide": "1.61.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "vite": "8.3.5"
  }
}
